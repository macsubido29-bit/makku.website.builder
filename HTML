<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Website Builder</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #e9e9e9;
}

/* TOP TOOLBAR */
.toolbar {
    height: 60px;
    background: #222;
    color: white;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 15px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
}

.toolbar button {
    border: none;
    padding: 9px 14px;
    border-radius: 6px;
    cursor: pointer;
    background: white;
}

.toolbar button:hover {
    background: #ddd;
}

/* WEBSITE AREA */
#website {
    width: 90%;
    max-width: 1200px;
    min-height: 700px;
    margin: 90px auto 40px;
    background: white;
    padding: 40px;
    position: relative;
}

/* EDITABLE ELEMENT */
.editable {
    padding: 10px;
    margin: 10px;
    border: 1px dashed transparent;
    cursor: pointer;
}

.editable:hover {
    border: 1px dashed #777;
}

.selected {
    border: 2px solid #007bff !important;
}

/* TEXT */
.title {
    font-size: 42px;
    font-weight: bold;
}

.subtitle {
    font-size: 20px;
}

/* BUTTON */
.site-button {
    display: inline-block;
    padding: 12px 25px;
    background: #007bff;
    color: white;
    border-radius: 7px;
    text-decoration: none;
    cursor: pointer;
}

/* SIDE PANEL */
#editorPanel {
    position: fixed;
    right: 0;
    top: 60px;
    width: 260px;
    height: calc(100vh - 60px);
    background: white;
    padding: 20px;
    box-shadow: -3px 0 10px rgba(0,0,0,.15);
    display: none;
    z-index: 999;
}

#editorPanel input,
#editorPanel textarea,
#editorPanel select {
    width: 100%;
    padding: 8px;
    margin: 6px 0 15px;
}

#editorPanel button {
    width: 100%;
    padding: 10px;
    margin-bottom: 8px;
    cursor: pointer;
}
</style>
</head>

<body>

<!-- TOOLBAR -->
<div class="toolbar">

    <strong>MY WEBSITE BUILDER</strong>

    <button onclick="addText()">+ Text</button>

    <button onclick="addButton()">+ Button</button>

    <button onclick="changeBackground()">
        Background
    </button>

    <button onclick="saveWebsite()">
        Save HTML
    </button>

    <button onclick="previewWebsite()">
        Preview
    </button>

</div>


<!-- EDITOR PANEL -->
<div id="editorPanel">

    <h3>Edit Element</h3>

    <label>Text</label>

    <textarea
        id="editText"
        rows="4"
        oninput="updateText()">
    </textarea>

    <label>Font Size</label>

    <input
        type="number"
        id="fontSize"
        oninput="updateFontSize()">

    <label>Text Color</label>

    <input
        type="color"
        id="textColor"
        onchange="updateColor()">

    <button onclick="deleteElement()">
        Delete Element
    </button>

    <button onclick="closeEditor()">
        Close
    </button>

</div>


<!-- WEBSITE -->
<div id="website">

    <h1
        class="editable title"
        onclick="selectElement(this)">
        My Website
    </h1>

    <p
        class="editable subtitle"
        onclick="selectElement(this)">
        Click this text to edit it.
    </p>

    <a
        class="editable site-button"
        onclick="selectElement(this)">
        Shop Now
    </a>

</div>


<script>

let selectedElement = null;


/* SELECT ELEMENT */

function selectElement(element) {

    if (selectedElement) {
        selectedElement.classList.remove("selected");
    }

    selectedElement = element;

    selectedElement.classList.add("selected");

    document.getElementById("editorPanel").style.display = "block";

    document.getElementById("editText").value =
        selectedElement.innerText;

    document.getElementById("fontSize").value =
        parseInt(
            window.getComputedStyle(selectedElement).fontSize
        );

}


/* UPDATE TEXT */

function updateText() {

    if (!selectedElement) return;

    selectedElement.innerText =
        document.getElementById("editText").value;

}


/* UPDATE FONT SIZE */

function updateFontSize() {

    if (!selectedElement) return;

    selectedElement.style.fontSize =
        document.getElementById("fontSize").value + "px";

}


/* UPDATE COLOR */

function updateColor() {

    if (!selectedElement) return;

    selectedElement.style.color =
        document.getElementById("textColor").value;

}


/* ADD TEXT */

function addText() {

    let text = document.createElement("p");

    text.className = "editable";

    text.innerText = "New Text";

    text.onclick = function() {
        selectElement(this);
    };

    document.getElementById("website")
        .appendChild(text);

}


/* ADD BUTTON */

function addButton() {

    let button = document.createElement("a");

    button.className =
        "editable site-button";

    button.innerText =
        "New Button";

    button.onclick = function() {
        selectElement(this);
    };

    document.getElementById("website")
        .appendChild(button);

}


/* BACKGROUND */

function changeBackground() {

    let color =
        prompt(
            "Enter background color:",
            "#ffffff"
        );

    if (color) {

        document.getElementById("website")
            .style.background = color;

    }

}


/* DELETE */

function deleteElement() {

    if (!selectedElement) return;

    selectedElement.remove();

    selectedElement = null;

    document.getElementById("editorPanel")
        .style.display = "none";

}


/* CLOSE EDITOR */

function closeEditor() {

    if (selectedElement) {
        selectedElement.classList.remove("selected");
    }

    selectedElement = null;

    document.getElementById("editorPanel")
        .style.display = "none";

}


/* PREVIEW */

function previewWebsite() {

    document.querySelector(".toolbar").style.display =
        "none";

    document.getElementById("editorPanel").style.display =
        "none";

}


/* SAVE WEBSITE */

function saveWebsite() {

    let website =
        document.getElementById("website").outerHTML;

    let html = `
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>My Website</title>
<style>
body {
    margin:0;
    font-family:Arial,sans-serif;
}
#website {
    padding:40px;
}
.site-button {
    display:inline-block;
    padding:12px 25px;
    background:#007bff;
    color:white;
    border-radius:7px;
    text-decoration:none;
}
</style>
</head>
<body>

${website}

</body>
</html>
`;

    let file =
        new Blob([html], {
            type: "text/html"
        });

    let link =
        document.createElement("a");

    link.href =
        URL.createObjectURL(file);

    link.download =
        "my-website.html";

    link.click();

}

</script>

</body>
</html>
